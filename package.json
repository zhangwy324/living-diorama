{
  "name": "living-diorama",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @living-diorama/desktop tauri dev",
    "tauri": "pnpm --filter @living-diorama/desktop tauri",
    "build": "tsc -b && pnpm --filter @living-diorama/desktop build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "depcruise apps packages tools",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm boundaries && pnpm test",
    "worldgen": "tsx tools/development/src/worldgen/cli.ts",
    "soak": "tsx tools/development/src/soak.ts",
    "sim": "tsx tools/development/src/sim.ts",
    "measure": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/development/measure-app.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
