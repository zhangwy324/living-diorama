{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": ".tsbuild",
    // For `new URL(…, import.meta.url)` asset URLs; Vite and Node both provide them.
    "lib": ["ES2023", "DOM"]
  },
  "include": ["src", "src/**/*.json"],
  "references": [
    {
      "path": "../../packages/content-schema"
    },
    {
      "path": "../../packages/extension-api"
    }
  ]
}
