# Normalize to LF in the repo and working tree, regardless of core.autocrlf.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets (heightfields, textures, models, icons).
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.glb binary
*.raw binary
